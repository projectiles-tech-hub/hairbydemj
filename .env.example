# Copy to .env (never committed) and fill in values for your environment.

# development | production
NODE_ENV=development

# Address and port the server listens on
HOST=127.0.0.1
PORT=3000

# Hostnames the server answers on.
# Local development: *.localhost names resolve to your own computer in browsers.
SITE_HOST=localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost

# Folder with static files (CSS, browser scripts, icons)
PUBLIC_DIR=public

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL database address, including the user's password. SECRET: keep it
# only in .env on your computer and in the server's environment settings.
# Form: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://hairbydemj:change-me@127.0.0.1:5432/hairbydemj

# Only for running the database tests: a PostgreSQL address whose user may
# create and drop databases. Each test run makes its own throwaway database.
# Leave empty to skip the database tests.
TEST_DATABASE_URL=

# Signs short-lived tokens and encrypts staff two-step secrets. SECRET.
# At least 32 random characters; required in production. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later means every staff member must set up two-step verification again.
AUTH_SECRET=

# Google and Apple sign-in. These IDs are not secret. Separate several with commas.
# Leave empty to turn that sign-in off.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# true when the server is behind our Caddy proxy (default in production).
TRUST_PROXY=false

# Folder for uploaded photos and videos. Not secret. On the live server use a
# folder outside the code that is included in the backups.
# The server also needs: sudo apt install libvips-tools ffmpeg
MEDIA_DIR=uploads

# Where daily exchange rates are fetched (free, no key, naira as the base). Not secret.
RATES_URL=https://open.er-api.com/v6/latest/NGN

# Payments. Secret keys are SECRET: only in .env and the server's settings.
# Test keys (sk_test_, pk_test_) until launch. See docs/payments.md.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Carriers. Keys and secrets are SECRET: only in .env and the server's settings.
# Leave a carrier empty to leave it out of checkout. Leave the *_API_URL lines
# empty for the live services; the test addresses are in docs/shipping.md.
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_API_URL=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_API_URL=
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
FEDEX_API_URL=

# Email. smtp on the live server (Postfix on the same machine); log on your computer.
# DKIM_PRIVATE_KEY is SECRET: one line, \n for each line break. See docs/notifications.md.
MAIL_TRANSPORT=log
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hairbydemj <hello@hairbydemj.com>
MAIL_REPLY_TO=
DKIM_DOMAIN=hairbydemj.com
DKIM_SELECTOR=mail
DKIM_PRIVATE_KEY=

# App push. Private keys are SECRET: one line, \n for each line break.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.hairbydemj.app
APNS_URL=https://api.push.apple.com
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Operations (module 19; only on the server). See docs/operations.md.
# Where alerts go: failed deployments and backups, restore test results,
# stopped services, a full disk. Not secret.
ALERT_EMAIL=
# The encrypted rclone remote that backups go to (production only). Not secret.
BACKUP_REMOTE=hbd-backup
# An empty database used only by the monthly restore test. SECRET (holds the password).
RESTORE_TEST_DATABASE_URL=
