# Copy to .env (never committed) and fill in values for your environment.

# development | production
NODE_ENV=development

# Address and port the server listens on
HOST=127.0.0.1
PORT=3000

# Hostnames the server answers on.
# Local development: *.localhost names resolve to your own computer in browsers.
SITE_HOST=localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost

# Folder with static files (CSS, browser scripts, icons)
PUBLIC_DIR=public

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL database address, including the user's password. SECRET: keep it
# only in .env on your computer and in the server's environment settings.
# Form: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://hairbydemj:change-me@127.0.0.1:5432/hairbydemj

# Only for running the database tests: a PostgreSQL address whose user may
# create and drop databases. Each test run makes its own throwaway database.
# Leave empty to skip the database tests.
TEST_DATABASE_URL=
