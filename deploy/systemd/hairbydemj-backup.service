# Daily encrypted backup to Google Drive (deploy/bin/backup.sh).
# Logs: journalctl -u hairbydemj-backup

[Unit]
Description=hairbydemj daily backup
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=hairbydemj-alert@%n.service

[Service]
Type=oneshot
User=hairbydemj
Group=hairbydemj
ExecStart=/srv/hairbydemj/current/deploy/bin/backup.sh production
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hairbydemj/shared/backups
# rclone keeps its Google sign-in fresh in this file.
ReadWritePaths=/srv/hairbydemj/shared/rclone.conf
