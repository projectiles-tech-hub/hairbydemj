# The background worker: labels, emails, reminders, alerts and scheduled tasks.
# The staging copy of hairbydemj-worker.service. Installed by deploy/setup-server.sh.
# Logs: journalctl -u hairbydemj-staging-worker -f

[Unit]
Description=hairbydemj staging background worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=hairbydemj
Group=hairbydemj
WorkingDirectory=/srv/hairbydemj-staging/current
# The same settings file as the web server. Secrets live only in this file on the server.
EnvironmentFile=/srv/hairbydemj-staging/shared/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/server/worker/main.js
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

# Keep the worker to what it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hairbydemj-staging/shared/uploads

[Install]
WantedBy=multi-user.target
