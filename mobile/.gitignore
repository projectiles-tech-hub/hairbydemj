# Made by Flutter when building; never committed.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
.idea/
# Platform files that `flutter create .` makes (see docs/app.md); our own
# changes to android/ and ios/ are committed, the rest is generated.
android/.gradle/
android/local.properties
android/gradlew
android/gradlew.bat
android/gradle/wrapper/gradle-wrapper.jar
android/app/src/main/java/io/flutter/plugins/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Pods/
ios/Runner/GeneratedPluginRegistrant.*
ios/.symlinks/
# Signing files and keys: never committed (decision: no secrets in the repo).
*.jks
*.keystore
key.properties
ios/Runner/GoogleService-Info.plist
android/app/google-services.json
